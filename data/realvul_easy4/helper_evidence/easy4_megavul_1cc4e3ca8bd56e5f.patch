From a3d22f60a719a6dae77a0586ef32dd12ac463952 Mon Sep 17 00:00:00 2001
From: agoode <agoode@chromium.org>
Date: Mon, 7 Dec 2015 00:00:35 -0800
Subject: [PATCH] Fix crash with MIDI send for MidiManagerAlsa

BUG=564501

Review URL: https://codereview.chromium.org/1500153002

Cr-Commit-Position: refs/heads/master@{#363413}
---
 media/midi/midi_manager.cc      | 9 ++++-----
 media/midi/midi_manager_alsa.cc | 4 ++--
 2 files changed, 6 insertions(+), 7 deletions(-)

diff --git a/media/midi/midi_manager.cc b/media/midi/midi_manager.cc
index be2a1d526a0e22..5fe9f2139f0ff3 100644
--- a/media/midi/midi_manager.cc
+++ b/media/midi/midi_manager.cc
@@ -149,11 +149,10 @@ void MidiManager::EndSession(MidiManagerClient* client) {
 }
 
 void MidiManager::AccumulateMidiBytesSent(MidiManagerClient* client, size_t n) {
-  {
-    base::AutoLock auto_lock(lock_);
-    if (clients_.find(client) == clients_.end())
-      return;
-  }
+  base::AutoLock auto_lock(lock_);
+  if (clients_.find(client) == clients_.end())
+    return;
+
   client->AccumulateMidiBytesSent(n);
 }
 
diff --git a/media/midi/midi_manager_alsa.cc b/media/midi/midi_manager_alsa.cc
index 7f213730cec96e..ad802c5a062711 100644
--- a/media/midi/midi_manager_alsa.cc
+++ b/media/midi/midi_manager_alsa.cc
@@ -299,8 +299,8 @@ void MidiManagerAlsa::DispatchSendMidiData(MidiManagerClient* client,
 
   // Acknowledge send.
   send_thread_.message_loop()->PostTask(
-      FROM_HERE, base::Bind(&MidiManagerClient::AccumulateMidiBytesSent,
-                            base::Unretained(client), data.size()));
+      FROM_HERE, base::Bind(&MidiManagerAlsa::AccumulateMidiBytesSent,
+                            base::Unretained(this), client, data.size()));
 }
 
 MidiManagerAlsa::MidiPort::Id::Id() = default;
