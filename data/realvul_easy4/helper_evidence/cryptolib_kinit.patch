+    if (is_safe_username(username) != CRYPTO_LIB_SUCCESS) {
+        return CAM_CONFIG_NOT_SUPPORTED_ERROR;
+    }
+    if (is_safe_path(keytab_file_path) != CRYPTO_LIB_SUCCESS) {
