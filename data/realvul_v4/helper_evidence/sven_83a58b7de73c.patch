From ebdef37b7e5d2b95a01d34b211c61c61da67e46a Mon Sep 17 00:00:00 2001
From: Joseph Hall <perlhoser@gmail.com>
Date: Fri, 11 Oct 2013 19:18:56 -0600
Subject: [PATCH] Fix command injection vulnerability in disk.usage

---
 salt/modules/disk.py | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/salt/modules/disk.py b/salt/modules/disk.py
index 1bd7a37a421b..2826204e3a21 100644
--- a/salt/modules/disk.py
+++ b/salt/modules/disk.py
@@ -31,6 +31,13 @@ def usage(args=None):
 
         salt '*' disk.usage
     '''
+    flags = ''
+    allowed = ('a', 'B', 'h', 'H', 'i', 'k', 'l', 'P', 't', 'T', 'x', 'v')
+    for flag in args:
+        if flag in allowed:
+            flags += flag
+        else:
+            break
     if __grains__['kernel'] == 'Linux':
         cmd = 'df -P'
     elif __grains__['kernel'] == 'OpenBSD':
@@ -38,7 +45,7 @@ def usage(args=None):
     else:
         cmd = 'df'
     if args:
-        cmd = cmd + ' -' + args
+        cmd += ' -{0}'.format(flags)
     ret = {}
     out = __salt__['cmd.run'](cmd).splitlines()
     for line in out:
